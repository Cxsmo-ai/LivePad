{
  "manifest_version": 3,
  "name": "LivePad — Controller Extension",
  "version": "1.3.5",
  "description": "Turns a physical gamepad into low-latency live chat controller frames for LivePad.",
  "permissions": ["storage", "tabs", "webNavigation", "scripting"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "LivePad",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "js": ["shared/protocol.js", "shared/gamepad_engine.js", "shared/dom_injector.js", "content.js"]
    }
  ]
}
