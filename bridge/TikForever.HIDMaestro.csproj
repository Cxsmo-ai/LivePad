<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TikForever.HIDMaestro</RootNamespace>
    <HidMaestroCoreDll Condition="'$(HidMaestroCoreDll)' == '' and '$(HIDMAESTRO_CORE_DLL)' == ''">$(MSBuildThisFileDirectory)vendor\HIDMaestro.Core.dll</HidMaestroCoreDll>
    <HidMaestroCoreDll Condition="'$(HidMaestroCoreDll)' == ''">$(HIDMAESTRO_CORE_DLL)</HidMaestroCoreDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HidMaestroCoreDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
